{
  "name": "react-native-agentation",
  "version": "0.0.8",
  "description": "Tap anything in a React Native app to get its component name and source file:line, for handing to AI coding agents.",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "!src/*.test.ts"
  ],
  "scripts": {
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "inspector",
    "devtools",
    "ai",
    "agent"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "19.1.0",
    "react-native": "0.87.0",
    "typescript": "^5.9.0"
  }
}
